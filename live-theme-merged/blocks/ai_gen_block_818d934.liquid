{% doc %}
  @prompt
    a section of advantages of the pants - wht but them. with small minimal icons that i can replace by my own and small text below. six advatages, but i can add more or remove them tif i delete the text and choose icon "none". add an option to select desktop or mobile padding from the sides, gap between the icon and the text and icons size, i want to change the icon by my own. and please an top and bottom padding i can change, and a theme i can change - background color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-advantages-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding-left: {{ block.settings.desktop_padding }}px;
    padding-right: {{ block.settings.desktop_padding }}px;
    padding-top: {{ block.settings.top_padding }}px;
    padding-bottom: {{ block.settings.bottom_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-advantages-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: {{ block.settings.gap }}px;
    width: 100%;
  }

  .ai-advantage-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-advantage-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-advantage-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-advantage-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-advantage-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-advantages-{{ ai_gen_id }} {
      padding-left: {{ block.settings.mobile_padding }}px;
      padding-right: {{ block.settings.mobile_padding }}px;
    }

    .ai-advantages-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    }
  }
{% endstyle %}

<advantages-block-{{ ai_gen_id }} class="ai-advantages-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-advantages-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign text_key = 'advantage_' | append: i | append: '_text'
        assign icon_key = 'advantage_' | append: i | append: '_icon'
        assign advantage_text = block.settings[text_key]
        assign advantage_icon = block.settings[icon_key]
      %}

      {% if advantage_text != blank %}
        <div class="ai-advantage-item-{{ ai_gen_id }}">
          <div class="ai-advantage-icon-{{ ai_gen_id }}">
            {% if advantage_icon != blank %}
              <img
                src="{{ advantage_icon | image_url: width: 200 }}"
                alt="{{ advantage_text | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            {% endif %}
          </div>
          <div class="ai-advantage-text-{{ ai_gen_id }}">{{ advantage_text }}</div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</advantages-block-{{ ai_gen_id }}>

<script>
  (function() {
    class AdvantagesBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('advantages-block-{{ ai_gen_id }}', AdvantagesBlock{{ ai_gen_id }});
  })();
</script>

