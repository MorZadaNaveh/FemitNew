{%- style -%}
  .femit-icon-reasons-{{ section.id }} {
    background: {{ section.settings.background_color | default: '#f5f3f3' }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="femit-icon-reasons-{{ section.id }}">
  <div class="femit-section femit-icon-reasons__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="femit-icon-reasons__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="femit-icon-reasons__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="femit-icon-reasons__grid">
        {%- for block in section.blocks -%}
          <div class="femit-icon-reasons__item" {{ block.shopify_attributes }}>
            <div class="femit-icon-circle femit-icon-reasons__icon">
              {% render 'femit-icon', icon: block.settings.icon %}
            </div>
            <span class="femit-icon-reasons__label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- stylesheet -%}
  .femit-icon-reasons__inner {
    text-align: center;
  }

  .femit-icon-reasons__heading {
    font-size: 24px;
    font-weight: 700;
    color: var(--femit-primary);
    margin: 0 0 8px;
  }

  .femit-icon-reasons__subheading {
    font-size: 15px;
    color: var(--femit-on-surface-variant);
    max-width: 36rem;
    margin: 0 auto 32px;
  }

  .femit-icon-reasons__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  @media screen and (min-width: 750px) {
    .femit-icon-reasons__grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .femit-icon-reasons__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .femit-icon-reasons__icon {
    width: 64px;
    height: 64px;
    background: var(--femit-primary-fixed, rgba(0,101,123,0.12));
    color: var(--femit-primary);
  }

  .femit-icon-reasons__icon svg {
    width: 28px;
    height: 28px;
  }

  .femit-icon-reasons__label {
    font-size: 13px;
    font-weight: 600;
    color: var(--femit-on-surface);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit Icon Reasons",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "למה ZipHers?" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "קלילות ופשטות כשאת צריכה להתפנות, יחד עם חומרים איכותיים לטיולים ארוכים." },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#f5f3f3" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "sun", "label": "Sun/SPF" },
            { "value": "bag", "label": "Bag/pockets" },
            { "value": "wind", "label": "Wind/breathable" },
            { "value": "accessibility", "label": "Accessibility/fit" },
            { "value": "eco", "label": "Eco" },
            { "value": "heart", "label": "Heart" },
            { "value": "droplet", "label": "Droplet" }
          ],
          "default": "sun"
        },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Femit Icon Reasons",
      "blocks": [
        { "type": "reason", "settings": { "icon": "sun", "label": "הגנת SPF-40" } },
        { "type": "reason", "settings": { "icon": "bag", "label": "כיסים עמוקים ונוחים" } },
        { "type": "reason", "settings": { "icon": "wind", "label": "בד נושם" } },
        { "type": "reason", "settings": { "icon": "accessibility", "label": "מותן גבוה" } },
        { "type": "reason", "settings": { "icon": "eco", "label": "ידידותי לסביבה" } }
      ]
    }
  ]
}
{% endschema %}
