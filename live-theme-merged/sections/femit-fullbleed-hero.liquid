{%- style -%}
  .femit-fullbleed-hero-{{ section.id }} {
    min-height: {{ section.settings.height }}px;
  }
{%- endstyle -%}

<div class="femit-fullbleed-hero-{{ section.id }} femit-fullbleed-hero">
  {%- if section.settings.image != blank -%}
    <img
      class="femit-fullbleed-hero__image"
      src="{{ section.settings.image | image_url: width: 1600 }}"
      loading="eager"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      alt="{{ section.settings.heading | escape }}"
    >
  {%- else -%}
    <img class="femit-fullbleed-hero__image" src="{{ 'femit-img-ziphers-hero.jpg' | asset_url }}" loading="eager" width="512" height="285" alt="{{ section.settings.heading | escape }}">
  {%- endif -%}
  <div class="femit-fullbleed-hero__overlay"></div>
  <div class="femit-fullbleed-hero__content femit-section">
    {%- if section.settings.heading != blank -%}
      <h1 class="femit-fullbleed-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="femit-fullbleed-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
        class="femit-btn femit-btn--primary femit-fullbleed-hero__button"
      >
        {{ section.settings.button_label | escape }}
        {% render 'femit-icon', icon: 'arrow' %}
      </a>
    {%- endif -%}
  </div>
</div>

{%- stylesheet -%}
  .femit-fullbleed-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .femit-fullbleed-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .femit-fullbleed-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
  }

  .femit-fullbleed-hero__content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 46rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .femit-fullbleed-hero__heading {
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
    color: #fff;
    margin: 0;
    text-shadow: 0 2px 8px rgba(0,0,0,0.3);
  }

  @media screen and (min-width: 750px) {
    .femit-fullbleed-hero__heading {
      font-size: 42px;
      line-height: 50px;
    }
  }

  .femit-fullbleed-hero__subheading {
    font-size: 16px;
    line-height: 26px;
    color: #fff;
    text-shadow: 0 1px 6px rgba(0,0,0,0.3);
    margin: 0;
  }

  .femit-fullbleed-hero__button {
    margin-top: 8px;
  }

  .femit-fullbleed-hero__button svg {
    width: 18px;
    height: 18px;
    transform: scaleX(-1);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit Fullbleed Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "height", "min": 300, "max": 800, "step": 20, "unit": "px", "label": "Minimum height", "default": 560 },
    { "type": "text", "id": "heading", "label": "Heading", "default": "נשים בטבע: פתרונות ייחודיים לנשים מטיילות" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "מכירה את זה שאת בטיול בטבע, צריכה להתפנות ואז מחפשת מקום להתחבא או פשוט מתאפקת? בדיוק בשביל זה מכנסי ZipHers כאן." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "בואי לנסות" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Femit Fullbleed Hero" }]
}
{% endschema %}
