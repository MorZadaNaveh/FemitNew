{%- style -%}
  .femit-fullbleed-hero-{{ section.id }} {
    padding-block: {{ section.settings.padding_top | default: 40 }}px {{ section.settings.padding_bottom | default: 40 }}px;
  }
{%- endstyle -%}

<div class="femit-fullbleed-hero-{{ section.id }} femit-section">
  <div class="femit-fullbleed-hero__inner">
    <div class="femit-fullbleed-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="femit-fullbleed-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="femit-fullbleed-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
          class="femit-btn femit-btn--primary femit-fullbleed-hero__button"
        >{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="femit-fullbleed-hero__media">
      {%- if section.settings.image != blank -%}
        <img
          class="femit-fullbleed-hero__image femit-fullbleed-hero__image--{{ section.settings.image_size }}"
          src="{{ section.settings.image | image_url: width: 1200 }}"
          loading="eager"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        >
      {%- else -%}
        <img class="femit-fullbleed-hero__image femit-fullbleed-hero__image--{{ section.settings.image_size }}" src="{{ 'femit-img-ziphers-hero.jpg' | asset_url }}" loading="eager" width="512" height="285" alt="{{ section.settings.heading | escape }}">
      {%- endif -%}
    </div>
  </div>
</div>

{%- stylesheet -%}
  .femit-fullbleed-hero__inner {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--femit-space-lg);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .femit-fullbleed-hero__inner {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }
  }

  .femit-fullbleed-hero__content {
    flex: 0 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--femit-space-md);
  }

  @media screen and (min-width: 750px) {
    .femit-fullbleed-hero__content {
      width: 40%;
    }
  }

  .femit-fullbleed-hero__heading {
    font-size: 30px;
    line-height: 36px;
    font-weight: 700;
    color: var(--femit-on-surface);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .femit-fullbleed-hero__heading {
      font-size: 44px;
      line-height: 52px;
    }
  }

  .femit-fullbleed-hero__heading em {
    color: var(--femit-primary);
    font-style: italic;
  }

  .femit-fullbleed-hero__subheading {
    font-size: 17px;
    line-height: 28px;
    color: var(--femit-on-surface-variant);
    margin: 0;
  }

  .femit-fullbleed-hero__media {
    width: 100%;
    flex: 1;
  }

  @media screen and (min-width: 750px) {
    .femit-fullbleed-hero__media {
      width: 60%;
    }
  }

  .femit-fullbleed-hero__image {
    width: 100%;
    object-fit: cover;
    border-radius: var(--femit-radius-lg);
    box-shadow: var(--femit-shadow-ambient-hover);
  }

  .femit-fullbleed-hero__image--small {
    height: 220px;
  }

  .femit-fullbleed-hero__image--medium {
    height: 340px;
  }

  .femit-fullbleed-hero__image--large {
    height: 460px;
  }

  .femit-fullbleed-hero__image--auto {
    height: auto;
    object-fit: contain;
  }

  @media screen and (min-width: 750px) {
    .femit-fullbleed-hero__image--small {
      height: 360px;
    }

    .femit-fullbleed-hero__image--medium {
      height: 520px;
    }

    .femit-fullbleed-hero__image--large {
      height: 680px;
    }

    .femit-fullbleed-hero__image--auto {
      height: auto;
    }
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit Fullbleed Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "auto", "label": "Adjust to image" }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in italics from the editor to highlight it in teal",
      "default": "<p>נשים בטבע: פתרונות ייחודיים לנשים <em>מטיילות</em></p>"
    },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "מכירה את זה שאת בטיול בטבע, צריכה להתפנות ואז מחפשת מקום להתחבא או פשוט מתאפקת? בדיוק בשביל זה מכנסי ZipHers כאן." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "בואי לנסות" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "presets": [{ "name": "Femit Fullbleed Hero" }]
}
{% endschema %}
