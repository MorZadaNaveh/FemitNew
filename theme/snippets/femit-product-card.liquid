{%- comment -%}
  Renders a single product card in the Femit bento shop style.
  Usage: {% render 'femit-product-card', card_product: product %}
{%- endcomment -%}

<article class="femit-product-card femit-ambient-shadow" data-collections="{{ card_product.collections | map: 'handle' | join: ',' }}">
  <a href="{{ card_product.url }}" class="femit-product-card__media">
    {%- if card_product.featured_image != blank -%}
      <img
        class="femit-product-card__image"
        src="{{ card_product.featured_image | image_url: width: 600 }}"
        srcset="{{ card_product.featured_image | image_url: width: 400 }} 400w, {{ card_product.featured_image | image_url: width: 600 }} 600w"
        sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
        loading="lazy"
        width="{{ card_product.featured_image.width }}"
        height="{{ card_product.featured_image.height }}"
        alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'femit-product-card__image femit-product-card__image--placeholder' }}
    {%- endif -%}
    {%- if card_product.tags contains 'רב מכר' -%}
      <span class="femit-product-card__badge">רב מכר</span>
    {%- endif -%}
  </a>
  <div class="femit-product-card__body">
    <a href="{{ card_product.url }}" class="femit-product-card__title-link">
      <h3 class="femit-product-card__title">{{ card_product.title }}</h3>
    </a>
    {%- if card_product.description != blank -%}
      <p class="femit-product-card__description">{{ card_product.description | strip_html | truncate: 80 }}</p>
    {%- endif -%}
    <div class="femit-product-card__footer">
      <span class="femit-product-card__price">{{ card_product.price | money }}</span>
      {%- if card_product.variants.size == 1 and card_product.selected_or_first_available_variant.available -%}
        <form action="{{ routes.cart_add_url }}" method="post" class="femit-product-card__form">
          <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
          <button type="submit" class="femit-btn femit-btn--primary femit-product-card__button">
            הוסיפי לעגלה
          </button>
        </form>
      {%- elsif card_product.available -%}
        <a href="{{ card_product.url }}" class="femit-btn femit-btn--primary femit-product-card__button">
          בחרי אפשרויות
        </a>
      {%- else -%}
        <span class="femit-product-card__sold-out">אזל המלאי</span>
      {%- endif -%}
    </div>
  </div>
</article>

{%- stylesheet -%}
  .femit-product-card {
    background: var(--femit-surface-container-lowest, #fff);
    border-radius: var(--femit-radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .femit-product-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--femit-surface-container-low);
    overflow: hidden;
  }

  .femit-product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .femit-product-card:hover .femit-product-card__image {
    transform: scale(1.05);
  }

  .femit-product-card__image--placeholder {
    padding: 32px;
    opacity: 0.5;
  }

  .femit-product-card__badge {
    position: absolute;
    top: 8px;
    inset-inline-end: 8px;
    background: var(--femit-secondary-container);
    color: var(--femit-on-secondary-container);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--femit-radius-full);
  }

  .femit-product-card__body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .femit-product-card__title-link {
    text-decoration: none;
    color: inherit;
  }

  .femit-product-card__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--femit-on-surface);
    margin: 0 0 4px;
  }

  .femit-product-card__description {
    font-size: 13px;
    line-height: 18px;
    color: var(--femit-on-surface-variant);
    margin: 0;
    flex: 1;
  }

  .femit-product-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    gap: 8px;
  }

  @media screen and (max-width: 749px) {
    .femit-product-card__footer {
      flex-wrap: wrap;
    }

    .femit-product-card__price {
      order: 1;
    }

    .femit-product-card__form,
    .femit-product-card__button {
      order: 2;
      width: 100%;
    }
  }

  .femit-product-card__price {
    font-size: 16px;
    font-weight: 700;
    color: var(--femit-primary);
    white-space: nowrap;
  }

  .femit-product-card__form {
    margin: 0;
  }

  .femit-product-card__button {
    padding: 8px 16px;
    font-size: 13px;
    white-space: nowrap;
    text-align: center;
  }

  .femit-product-card__sold-out {
    font-size: 13px;
    color: var(--femit-on-surface-variant);
  }
{%- endstylesheet -%}
