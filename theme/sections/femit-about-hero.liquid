{%- style -%}
  .femit-about-hero-{{ section.id }} {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="femit-about-hero-{{ section.id }} femit-section">
  <div class="femit-about-hero__inner">
    <div class="femit-about-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="femit-about-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="femit-about-hero__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
          class="femit-btn femit-btn--primary femit-about-hero__button"
        >
          {{ section.settings.button_label | escape }}
          {% render 'femit-icon', icon: 'arrow' %}
        </a>
      {%- endif -%}
    </div>
    <div class="femit-about-hero__media">
      <div class="femit-about-hero__blob femit-about-hero__blob--1" aria-hidden="true"></div>
      <div class="femit-about-hero__blob femit-about-hero__blob--2" aria-hidden="true"></div>
      <div class="femit-about-hero__frame">
        {%- if section.settings.image != blank -%}
          <img
            class="femit-about-hero__image"
            src="{{ section.settings.image | image_url: width: 800 }}"
            loading="eager"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            alt="{{ section.settings.heading | escape }}"
          >
        {%- else -%}
          <img class="femit-about-hero__image" src="{{ 'femit-img-about-founder.jpg' | asset_url }}" loading="eager" width="512" height="279" alt="{{ section.settings.heading | escape }}">
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- stylesheet -%}
  .femit-about-hero__inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--femit-space-lg);
  }

  @media screen and (min-width: 750px) {
    .femit-about-hero__inner {
      flex-direction: row;
      gap: 48px;
    }
  }

  .femit-about-hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--femit-space-md);
  }

  .femit-about-hero__heading {
    font-size: 28px;
    line-height: 34px;
    font-weight: 700;
    color: var(--femit-primary);
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .femit-about-hero__heading {
      font-size: 40px;
      line-height: 48px;
    }
  }

  .femit-about-hero__text {
    font-size: 16px;
    line-height: 26px;
    color: var(--femit-on-surface-variant);
  }

  .femit-about-hero__text p {
    margin: 0 0 12px;
  }

  .femit-about-hero__button {
    margin-top: 8px;
  }

  .femit-about-hero__button svg {
    width: 18px;
    height: 18px;
  }

  .femit-about-hero__media {
    position: relative;
    width: 100%;
    flex: 1;
    aspect-ratio: 4 / 5;
  }

  @media screen and (min-width: 750px) {
    .femit-about-hero__media {
      aspect-ratio: 1 / 1;
    }
  }

  .femit-about-hero__blob {
    position: absolute;
    inset: 0;
    border-radius: 40px;
  }

  .femit-about-hero__blob--1 {
    background: var(--femit-tertiary-fixed);
    opacity: 0.5;
    transform: translate(12px, 12px);
  }

  .femit-about-hero__blob--2 {
    background: var(--femit-secondary-container);
    opacity: 0.3;
    transform: translate(-12px, -12px);
  }

  .femit-about-hero__frame {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--femit-surface-container-lowest, #fff);
    border-radius: var(--femit-radius-lg);
    box-shadow: var(--femit-shadow-ambient-hover);
    overflow: hidden;
  }

  .femit-about-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit About Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "היי, אני מור." },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>כשהקמתי את Femit, החזון שלי היה פשוט אבל עמוק: ליצור מרחב שבו נשים יכולות להתמקד באיך שהן מרגישות, ולא רק באיך שהן נראות.</p><p>המסע שלי התחיל מהחיפוש האישי אחרי איזון. הבנתי שבריאות היא לא רשימת מטלות נוקשה, אלא חוויה רכה, עוטפת, ומלאת חמלה. זה מה שאנחנו מבקשות להביא לכל אישה - כלים נגישים, תמיכה אמיתית, וקהילה שרואה אותך באמת.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "הצטרפי לקהילה שלנו" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 24 }
  ],
  "presets": [{ "name": "Femit About Hero" }]
}
{% endschema %}
