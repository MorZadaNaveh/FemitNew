{%- style -%}
  .femit-article-bento-{{ section.id }} {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="femit-article-bento-{{ section.id }} femit-section">
  <div class="femit-article-bento__header">
    <div>
      {%- if section.settings.heading != blank -%}
        <h2 class="femit-article-bento__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="femit-article-bento__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.view_all_link != blank -%}
      <a href="{{ section.settings.view_all_link }}" class="femit-article-bento__view-all">
        {{ section.settings.view_all_label }}
        {% render 'femit-icon', icon: 'arrow' %}
      </a>
    {%- endif -%}
  </div>

  <div class="femit-article-bento__grid">
    {%- assign main_article = section.settings.main_article -%}
    {%- if main_article != blank -%}
      <a href="{{ main_article.url }}" class="femit-article-bento__main femit-ambient-shadow">
        {%- if section.settings.main_image != blank -%}
          <img
            class="femit-article-bento__main-image"
            src="{{ section.settings.main_image | image_url: width: 900 }}"
            loading="lazy"
            width="{{ section.settings.main_image.width }}"
            height="{{ section.settings.main_image.height }}"
            alt="{{ main_article.title | escape }}"
          >
        {%- elsif main_article.image != blank -%}
          <img
            class="femit-article-bento__main-image"
            src="{{ main_article.image | image_url: width: 900 }}"
            loading="lazy"
            width="{{ main_article.image.width }}"
            height="{{ main_article.image.height }}"
            alt="{{ main_article.title | escape }}"
          >
        {%- else -%}
          <img class="femit-article-bento__main-image" src="{{ 'femit-img-menopause-article-kitchen.jpg' | asset_url }}" loading="lazy" width="512" height="279" alt="{{ main_article.title | escape }}">
        {%- endif -%}
        <div class="femit-article-bento__main-overlay"></div>
        <div class="femit-article-bento__main-content">
          {%- if section.settings.main_article_tag != blank -%}
            <span class="femit-article-bento__badge">{{ section.settings.main_article_tag }}</span>
          {%- endif -%}
          <h3 class="femit-article-bento__main-title">{{ main_article.title }}</h3>
          {%- if main_article.excerpt != blank -%}
            <p class="femit-article-bento__main-excerpt">{{ main_article.excerpt | strip_html | truncate: 130 }}</p>
          {%- endif -%}
        </div>
      </a>
    {%- endif -%}

    <div class="femit-article-bento__side">
      {%- for block in section.blocks -%}
        {%- assign side_article = block.settings.article -%}
        {%- if side_article != blank -%}
          <a href="{{ side_article.url }}" class="femit-article-bento__side-card femit-ambient-shadow" {{ block.shopify_attributes }}>
            <div class="femit-article-bento__side-top">
              <span class="femit-article-bento__side-tag">{{ block.settings.tag_label }}</span>
              <span class="femit-article-bento__side-icon">{% render 'femit-icon', icon: block.settings.icon %}</span>
            </div>
            <h4 class="femit-article-bento__side-title">{{ side_article.title }}</h4>
            {%- if side_article.excerpt != blank -%}
              <p class="femit-article-bento__side-excerpt">{{ side_article.excerpt | strip_html | truncate: 90 }}</p>
            {%- endif -%}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- stylesheet -%}
  .femit-article-bento__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 24px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .femit-article-bento__heading {
    font-size: 24px;
    font-weight: 700;
    color: var(--femit-on-surface);
    margin: 0 0 4px;
  }

  .femit-article-bento__subheading {
    font-size: 15px;
    color: var(--femit-on-surface-variant);
    max-width: 36rem;
    margin: 0;
  }

  .femit-article-bento__view-all {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--femit-primary);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .femit-article-bento__view-all svg {
    width: 16px;
    height: 16px;
  }

  .femit-article-bento__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .femit-article-bento__grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .femit-article-bento__main {
    position: relative;
    display: block;
    border-radius: var(--femit-radius-lg);
    overflow: hidden;
    text-decoration: none;
    min-height: 320px;
  }

  .femit-article-bento__main-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .femit-article-bento__main-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.75), transparent 60%);
  }

  .femit-article-bento__main-content {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 24px;
    color: #fff;
  }

  .femit-article-bento__badge {
    display: inline-block;
    background: rgba(255,255,255,0.9);
    color: var(--femit-primary);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: var(--femit-radius-full);
    margin-bottom: 8px;
  }

  .femit-article-bento__main-title {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 4px;
    color: #fff;
  }

  .femit-article-bento__main-excerpt {
    font-size: 14px;
    margin: 0;
    opacity: 0.9;
    color: #fff;
  }

  .femit-article-bento__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .femit-article-bento__side-card {
    background: var(--femit-surface-container-lowest, #fff);
    border-radius: var(--femit-radius-lg);
    padding: 20px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .femit-article-bento__side-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .femit-article-bento__side-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--femit-tertiary);
  }

  .femit-article-bento__side-icon svg {
    width: 20px;
    height: 20px;
    color: var(--femit-outline-variant);
  }

  .femit-article-bento__side-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--femit-on-surface);
    margin: 0 0 4px;
  }

  .femit-article-bento__side-excerpt {
    font-size: 13px;
    line-height: 20px;
    color: var(--femit-on-surface-variant);
    margin: 0;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit Article Bento",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "תובנות וידע" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "מאמרים שנאצרו בקפידה כדי לעזור לך להבין את המדע של הגוף שלך ועצות מעשיות לחיוניות יומיומית." },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "צפו בכל המאמרים" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "article", "id": "main_article", "label": "Main featured article" },
    { "type": "image_picker", "id": "main_image", "label": "Main article image (optional, overrides the article's own image)" },
    { "type": "text", "id": "main_article_tag", "label": "Main article tag", "default": "תזונה" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "side_article",
      "name": "Side article",
      "settings": [
        { "type": "article", "id": "article", "label": "Article" },
        { "type": "text", "id": "tag_label", "label": "Tag label" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "spa", "label": "Fitness/spa" },
            { "value": "droplet", "label": "Hormones/droplet" },
            { "value": "heart", "label": "Heart" },
            { "value": "book", "label": "Book" }
          ],
          "default": "spa"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Femit Article Bento",
      "blocks": [
        { "type": "side_article", "settings": { "tag_label": "אימוני כוח", "icon": "spa" } },
        { "type": "side_article", "settings": { "tag_label": "הורמונים", "icon": "droplet" } }
      ]
    }
  ]
}
{% endschema %}
