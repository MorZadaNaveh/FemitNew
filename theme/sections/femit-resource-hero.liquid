{%- style -%}
  .femit-resource-hero-{{ section.id }} {
    background: {{ section.settings.background_color | default: 'rgba(251,219,222,0.4)' }};
    border-radius: var(--femit-radius-xl);
    margin-inline: 16px;
    margin-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    padding: 24px;
  }

  @media screen and (min-width: 750px) {
    .femit-resource-hero-{{ section.id }} {
      margin-inline: 48px;
      padding: 48px;
    }
  }
{%- endstyle -%}

<div class="femit-resource-hero-{{ section.id }}">
  <div class="femit-resource-hero__inner">
    {%- if section.settings.image != blank -%}
      <img
        class="femit-resource-hero__image"
        src="{{ section.settings.image | image_url: width: 700 }}"
        loading="eager"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.heading | escape }}"
      >
    {%- else -%}
      <img class="femit-resource-hero__image" src="{{ 'femit-img-resource-hero.jpg' | asset_url }}" loading="eager" width="512" height="286" alt="{{ section.settings.heading | escape }}">
    {%- endif -%}
    <div class="femit-resource-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="femit-resource-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="femit-resource-hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ section.settings.button_link }}"{% endif %}
          class="femit-btn femit-btn--primary"
        >{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{%- stylesheet -%}
  .femit-resource-hero__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .femit-resource-hero__inner {
      flex-direction: row;
      gap: 48px;
    }
  }

  .femit-resource-hero__image {
    width: 100%;
    max-width: 420px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--femit-radius-md);
  }

  .femit-resource-hero__image--placeholder svg {
    width: 100%;
    height: 100%;
  }

  .femit-resource-hero__content {
    flex: 1;
  }

  .femit-resource-hero__heading {
    font-size: 24px;
    line-height: 32px;
    font-weight: 700;
    color: var(--femit-on-surface);
    margin: 0 0 12px;
  }

  @media screen and (min-width: 750px) {
    .femit-resource-hero__heading {
      font-size: 32px;
      line-height: 40px;
    }
  }

  .femit-resource-hero__subheading {
    font-size: 16px;
    line-height: 26px;
    color: var(--femit-on-surface-variant);
    margin: 0 0 20px;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit Resource Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "גיל המעבר: כל מה שאת צריכה לדעת במקום אחד" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "מידע אמין, מקצועי ומעצים. ריכזנו עבורך מאמרים, הרצאות מומחים והמלצות מוצרים כדי לעזור לך לנווט את התקופה הזו בביטחון ובשמחה." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "התחילי לקרוא" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#fdeef0" },
    { "type": "header", "content": "Margin" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Top margin", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 4, "unit": "px", "label": "Bottom margin", "default": 24 }
  ],
  "presets": [{ "name": "Femit Resource Hero" }]
}
{% endschema %}
