{%- style -%}
  .femit-topic-index-{{ section.id }} {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="femit-topic-index-{{ section.id }} femit-section">
  <div class="femit-topic-index__header">
    {%- if section.settings.heading != blank -%}
      <h1 class="femit-topic-index__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="femit-topic-index__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="femit-topic-index__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_bg = block.settings.background_color | default: '#00657b'
          assign card_bg_brightness = card_bg | color_brightness
          if card_bg_brightness > 150
            assign text_color = '#1b1c1c'
            assign text_color_soft = '#3e484d'
          else
            assign text_color = '#ffffff'
            assign text_color_soft = '#ffffff'
          endif
        -%}
        <a
          href="{{ block.settings.link }}"
          class="femit-topic-index__card femit-ambient-shadow"
          style="background: {{ card_bg }}; color: {{ text_color }};"
          {{ block.shopify_attributes }}
        >
          <div class="femit-topic-index__badge">
            {%- if block.settings.image != blank -%}
              <img
                class="femit-topic-index__badge-image"
                src="{{ block.settings.image | image_url: width: 160 }}"
                loading="lazy"
                width="64"
                height="64"
                alt=""
              >
            {%- else -%}
              <span class="femit-icon-circle femit-topic-index__badge-icon" style="background: rgba(255,255,255,0.35); color: {{ text_color }};">
                {% render 'femit-icon', icon: block.settings.icon | default: 'community' %}
              </span>
            {%- endif -%}
          </div>
          <div class="femit-topic-index__content">
            <h3 class="femit-topic-index__title" style="color: {{ text_color }};">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="femit-topic-index__description" style="color: {{ text_color_soft }};">{{ block.settings.description }}</p>
            {%- endif -%}
            <span class="femit-topic-index__link" style="color: {{ text_color }};">{{ block.settings.link_label | default: 'גלי עוד' }} {% render 'femit-icon', icon: 'arrow' %}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- stylesheet -%}
  .femit-topic-index__header {
    text-align: center;
    margin-bottom: 32px;
  }

  .femit-topic-index__heading {
    font-size: 28px;
    font-weight: 700;
    color: var(--femit-primary);
    margin: 0 0 8px;
  }

  .femit-topic-index__subheading {
    font-size: 16px;
    color: var(--femit-on-surface-variant);
    max-width: 40rem;
    margin: 0 auto;
  }

  .femit-topic-index__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .femit-topic-index__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .femit-topic-index__card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--femit-radius-lg);
    overflow: hidden;
    text-decoration: none;
    min-height: 280px;
    padding: 24px;
    transition: transform 0.3s ease;
  }

  .femit-topic-index__card:hover {
    transform: translateY(-4px);
  }

  .femit-topic-index__badge {
    margin-bottom: 20px;
  }

  .femit-topic-index__badge-image {
    width: 64px;
    height: 64px;
    border-radius: var(--femit-radius-full);
    object-fit: cover;
    display: block;
  }

  .femit-topic-index__badge-icon {
    width: 64px;
    height: 64px;
  }

  .femit-topic-index__badge-icon svg {
    width: 30px;
    height: 30px;
  }

  .femit-topic-index__content {
    margin-top: auto;
  }

  .femit-topic-index__title {
    font-size: 22px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .femit-topic-index__description {
    font-size: 14px;
    margin: 0 0 12px;
  }

  .femit-topic-index__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
  }

  .femit-topic-index__link svg {
    width: 16px;
    height: 16px;
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit Topic Index",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "ספריית תכנים" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "כל מה שאת צריכה, מאורגן לפי מה שמעניין אותך עכשיו." },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "Topic card",
      "settings": [
        { "type": "color", "id": "background_color", "label": "Background color", "default": "#00657b" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon (used when no image is set)",
          "options": [
            { "value": "book", "label": "Book" },
            { "value": "chat", "label": "Chat" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "droplet", "label": "Droplet" },
            { "value": "spa", "label": "Spa" },
            { "value": "heart", "label": "Heart" },
            { "value": "community", "label": "Community" },
            { "value": "medical", "label": "Medical" },
            { "value": "hiking", "label": "Hiking" },
            { "value": "accessibility", "label": "Accessibility" },
            { "value": "book-open", "label": "Open book" },
            { "value": "fan", "label": "Fan" },
            { "value": "stop-hand", "label": "Stop hand" }
          ],
          "default": "community"
        },
        { "type": "image_picker", "id": "image", "label": "Small image (overrides icon, shown top-left)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "גלי עוד" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Femit Topic Index",
      "blocks": [
        { "type": "topic", "settings": { "title": "גיל המעבר", "description": "מידע, מוצרים ותמיכה למסע שלך", "link_label": "כניסה", "background_color": "#00657b", "icon": "medical" } },
        { "type": "topic", "settings": { "title": "טיולים", "description": "ציוד וידע לצאת לדרך בביטחון", "link_label": "כניסה", "background_color": "#fccc38", "icon": "hiking" } },
        { "type": "topic", "settings": { "title": "מיניות", "description": "היכרות מחודשת עם הגוף שלך", "link_label": "כניסה", "background_color": "#fbdbde", "icon": "heart" } }
      ]
    }
  ]
}
{% endschema %}
