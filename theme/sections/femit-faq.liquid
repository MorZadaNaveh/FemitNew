{%- style -%}
  .femit-faq-{{ section.id }} {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="femit-faq-{{ section.id }} femit-section femit-faq__container">
  {%- if section.settings.heading != blank -%}
    <h2 class="femit-faq__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="femit-faq__list">
      {%- for block in section.blocks -%}
        <details class="femit-faq__item femit-ambient-shadow" {{ block.shopify_attributes }}>
          <summary class="femit-faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="femit-faq__chevron" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </span>
          </summary>
          <div class="femit-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- stylesheet -%}
  .femit-faq__container {
    max-width: 48rem;
  }

  .femit-faq__heading {
    font-size: 24px;
    font-weight: 700;
    color: var(--femit-primary);
    text-align: center;
    margin: 0 0 24px;
  }

  .femit-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .femit-faq__item {
    background: var(--femit-surface-container-lowest, #fff);
    border-radius: var(--femit-radius-md);
    padding: 4px 20px;
  }

  .femit-faq__question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 16px;
    font-size: 16px;
    font-weight: 600;
    color: var(--femit-on-surface);
    cursor: pointer;
    list-style: none;
  }

  .femit-faq__question::-webkit-details-marker {
    display: none;
  }

  .femit-faq__chevron svg {
    width: 20px;
    height: 20px;
    color: var(--femit-primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .femit-faq__item[open] .femit-faq__chevron svg {
    transform: rotate(180deg);
  }

  .femit-faq__answer {
    padding-bottom: 16px;
    font-size: 14px;
    line-height: 22px;
    color: var(--femit-on-surface-variant);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "שאלות נפוצות" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Femit FAQ",
      "blocks": [{ "type": "question" }, { "type": "question" }]
    }
  ]
}
{% endschema %}
