{%- style -%}
  .femit-cta-banner-{{ section.id }} {
    background: {{ section.settings.background_color | default: '#00657b' }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<div class="femit-cta-banner-{{ section.id }}">
  <div class="femit-section femit-cta-banner__inner">
    <div class="femit-cta-banner__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="femit-cta-banner__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="femit-cta-banner__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      {%- liquid
        assign link_first_char = section.settings.button_link | slice: 0, 1
      -%}
      <a
        {% if section.settings.button_link == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ section.settings.button_link }}"
          {% unless link_first_char == '/' %}target="_blank" rel="noopener"{% endunless %}
        {% endif %}
        class="femit-btn femit-cta-banner__button"
      >{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{%- stylesheet -%}
  .femit-cta-banner__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .femit-cta-banner__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: right;
    }
  }

  .femit-cta-banner__heading {
    font-size: 22px;
    font-weight: 700;
    color: var(--femit-on-primary);
    margin: 0 0 4px;
  }

  .femit-cta-banner__subheading {
    font-size: 15px;
    color: var(--femit-on-primary);
    opacity: 0.9;
    margin: 0;
  }

  .femit-cta-banner__button {
    background: #fff;
    color: var(--femit-primary);
    white-space: nowrap;
  }

  .femit-cta-banner__button:hover {
    background: var(--femit-surface);
  }
{%- endstylesheet -%}

{% schema %}
{
  "name": "Femit CTA Banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "מצאי תמיכה מקצועית" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "התחברי לאנשי מקצוע בתחום הבריאות ולקהילה שמבינה את הצרכים הספציפיים שלך." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "צרי קשר" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#00657b" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 }
  ],
  "presets": [{ "name": "Femit CTA Banner" }]
}
{% endschema %}
